# Copy to `.env.local` for local development (that file is git-ignored).
# On Vercel, add these under Project -> Settings -> Environment Variables.
# NEVER put the secret in `.env` (it is committed to GitHub) or in any VITE_* variable.

# Razorpay (Dashboard -> Account & Settings -> API Keys). Test keys start with rzp_test_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# Optional: only needed if you also enable the Razorpay webhook (backup confirmation).
# RAZORPAY_WEBHOOK_SECRET=

# Supabase server key (Supabase -> Project Settings -> API Keys -> secret key)
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx
